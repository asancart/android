<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through backups: Profiles hold Device credentials, and cloud backup
     would go through Google services (REQ-APP-041). A new phone pairs again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
